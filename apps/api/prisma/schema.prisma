generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  name               String
  role               Role           @default(STAFF)
  desiredWeeklyHours Int            @default(40)
  skills             Skill[]
  certifiedLocations String[]
  deletedAt          DateTime?
  password           String
  assignments        Assignment[]
  availabilities     Availability[]
  receivedSwaps      SwapRequest[]  @relation("Receiver")
  initiatedSwaps     SwapRequest[]  @relation("Requester")
  notifications      Notification[]
  auditLogs          AuditLog[]     @relation("AuditActor")

  @@map("users")
}

model Location {
  id        String    @id @default(uuid())
  name      String
  timezone  String
  address   String?
  deletedAt DateTime?
  shifts    Shift[]

  @@map("locations")
}

model Shift {
  id                String        @id @default(uuid())
  locationId        String
  startTime         DateTime
  endTime           DateTime
  requiredSkill     Skill
  requiredHeadcount Int           @default(1)
  deletedAt         DateTime?
  status            ShiftStatus   @default(DRAFT)
  assignments       Assignment[]
  location          Location      @relation(fields: [locationId], references: [id])
  swaps             SwapRequest[]

  @@map("shifts")
}

model Assignment {
  id        String    @id @default(uuid())
  shiftId   String
  userId    String
  deletedAt DateTime?
  shift     Shift     @relation(fields: [shiftId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@map("assignments")
}

model Availability {
  id        String           @id @default(uuid())
  userId    String
  dayOfWeek Int?
  startTime String?
  endTime   String?
  date      DateTime?
  type      AvailabilityType @default(RECURRING)
  deletedAt DateTime?
  user      User             @relation(fields: [userId], references: [id])

  @@map("availabilities")
}

model SwapRequest {
  id             String          @id @default(uuid())
  type           SwapRequestType
  requesterId    String
  receiverId     String?
  shiftId        String
  status         SwapStatus      @default(PENDING)
  expiresAt      DateTime?
  acceptedAt     DateTime?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  receiver       User?           @relation("Receiver", fields: [receiverId], references: [id])
  requester      User            @relation("Requester", fields: [requesterId], references: [id])
  shift          Shift           @relation(fields: [shiftId], references: [id])

  @@index([requesterId, status])
  @@index([receiverId, status])
  @@index([shiftId, type, status])

  @@map("swap_requests")
}

model AuditLog {
  id         String          @id @default(uuid())
  entityType AuditEntityType
  entityId   String
  action     AuditAction
  actorId    String?
  targetUserId String?
  before     Json?
  after      Json?
  diff       Json?
  createdAt  DateTime        @default(now())
  actor      User?           @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum Skill {
  BARTENDER
  LINE_COOK
  SERVER
  HOST
}

enum AvailabilityType {
  RECURRING
  EXCEPTION
}

enum SwapStatus {
  PENDING
  ACCEPTED_BY_PEER
  APPROVED
  CANCELLED
  EXPIRED
}

enum SwapRequestType {
  SWAP
  DROP
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
}

enum AuditEntityType {
  SHIFT
  ASSIGNMENT
  SWAP_REQUEST
}

enum AuditAction {
  CREATE
  UPDATE
  SOFT_DELETE
  STATUS_CHANGE
}

enum NotificationType {
  SHIFT_ASSIGNED
  SHIFT_UNASSIGNED
  SHIFT_UPDATED
  SCHEDULE_PUBLISHED
  SWAP_REQUEST_UPDATED
  OVERTIME_WARNING
}
