generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  name               String
  role               Role           @default(STAFF)
  skills             Skill[]
  certifiedLocations String[]
  deletedAt          DateTime?
  password           String
  assignments        Assignment[]
  availabilities     Availability[]
  receivedSwaps      SwapRequest[]  @relation("Receiver")
  initiatedSwaps     SwapRequest[]  @relation("Requester")

  @@map("users")
}

model Location {
  id        String    @id @default(uuid())
  name      String
  timezone  String
  address   String?
  deletedAt DateTime?
  shifts    Shift[]

  @@map("locations")
}

model Shift {
  id                String        @id @default(uuid())
  locationId        String
  startTime         DateTime
  endTime           DateTime
  requiredSkill     Skill
  requiredHeadcount Int           @default(1)
  deletedAt         DateTime?
  status            ShiftStatus   @default(DRAFT)
  assignments       Assignment[]
  location          Location      @relation(fields: [locationId], references: [id])
  swaps             SwapRequest[]

  @@map("shifts")
}

model Assignment {
  id        String    @id @default(uuid())
  shiftId   String
  userId    String
  deletedAt DateTime?
  shift     Shift     @relation(fields: [shiftId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@map("assignments")
}

model Availability {
  id        String           @id @default(uuid())
  userId    String
  dayOfWeek Int?
  startTime String?
  endTime   String?
  date      DateTime?
  type      AvailabilityType @default(RECURRING)
  deletedAt DateTime?
  user      User             @relation(fields: [userId], references: [id])

  @@map("availabilities")
}

model SwapRequest {
  id             String          @id @default(uuid())
  type           SwapRequestType
  requesterId    String
  receiverId     String?
  shiftId        String
  status         SwapStatus      @default(PENDING)
  expiresAt      DateTime?
  acceptedAt     DateTime?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  receiver       User?           @relation("Receiver", fields: [receiverId], references: [id])
  requester      User            @relation("Requester", fields: [requesterId], references: [id])
  shift          Shift           @relation(fields: [shiftId], references: [id])

  @@index([requesterId, status])
  @@index([receiverId, status])
  @@index([shiftId, type, status])

  @@map("swap_requests")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum Skill {
  BARTENDER
  LINE_COOK
  SERVER
  HOST
}

enum AvailabilityType {
  RECURRING
  EXCEPTION
}

enum SwapStatus {
  PENDING
  ACCEPTED_BY_PEER
  APPROVED
  CANCELLED
  EXPIRED
}

enum SwapRequestType {
  SWAP
  DROP
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
}
